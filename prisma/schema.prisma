generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  displayName String?
  createdAt   DateTime @default(now())
}

model League {
  id               Int      @id @default(autoincrement())
  leagueName       String   @unique
  franchise        String @default("USA")
  season           Int    @default(18)
  owner            String
  users            String[]
  maxPlayers       Int
  createdAt        DateTime @default(now())
  maxQueensPerTeam Int      @default(3)
}

model Roster {
  recordId      Int      @id @default(autoincrement())
  leagueName    String
  username      String
  teamName      String
  franchise     String @default("USA")
  season        Int @default(18)
  queens        String[]
  currentPoints Int
  pointUpdates  Int[]
}

model Notification {
  notifId     Int      @id @default(autoincrement())
  source      String
  destination String
  resolved    Boolean  @default(false)
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Queen {
  queenId   Int         @id @default(autoincrement())
  franchise String
  season    Int
  name      String
  status    QueenStatus @default(ACTIVE)
  location  String
}

enum QueenStatus {
  WINNER
  ACTIVE
  ELIMINATED
  RUNNER_UP
  UNKNOWN_OR_ERROR
  MS_CONGENIALITY
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
}

enum BracketName {
  A
  B
  C
}

model ActiveSeasons {
  seasonId        Int            @id @default(autoincrement())
  franchise       String
  season          Int
  activityStatus  ActivityStatus @default(INACTIVE)
  premiereDate    String?
  isUsingBrackets Boolean        @default(false)
  bracketCount    Int?
  startDate       DateTime?
  endDate         DateTime?

  @@unique([franchise, season])
}

model Bracket {
  bracketId   Int         @id @default(autoincrement())
  franchise   String
  season      Int
  bracketName BracketName
  queens      String[]

  @@unique([franchise, season, bracketName])
}

model FanSurvey {
  id        Int             @id @default(autoincrement())
  franchise String
  season    Int
  episode   Int
  startDate DateTime
  endDate   DateTime
  computed  Boolean         @default(false)

  responses FanSurveyData[]

  @@unique([franchise, season, episode])
}

model FanSurveyData {
  id              Int       @id @default(autoincrement())
  surveyId        Int
  survey          FanSurvey @relation(fields: [surveyId], references: [id])
  submittedBy     String
  franchise       String
  season          Int
  episode         Int
  completedAt     DateTime  @default(now())
  queenOfTheWeek  String
  bottomOfTheWeek String
  lipSyncWinner   String
  bestDressed     String
  worstDressed    String

  @@unique([surveyId, submittedBy])
}

model EpisodeResult {
  id            Int      @id @default(autoincrement())
  franchise     String
  season        Int
  episode       Int
  maxiWinner    String[]
  topQueens     String[]
  eliminated    String[]
  lipSyncWinner String[]
  isSnatchGame  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([franchise, season, episode])
}

model SeasonFinaleResponse {
  id              Int      @id @default(autoincrement())
  franchise       String
  season          Int
  submittedBy     String
  winner          String
  runnerUp        String
  missCongeniality String
  bestDressed     String
  fanFavorite     String
  tradeOfTheSeason String
  mostImproved    String
  createdAt       DateTime @default(now())

  @@unique([franchise, season, submittedBy])
}

DATABASE_URL=
LOG_LEVEL=
CORS_ORIGIN=
JWT_SECRET=
ADMIN_API_KEY= # for protect admin routes (admin access to routes)
ADMIN_EMAIL= # admin allowlist checked by getAdminJwt and notification admin checks; comma-separated for multiple admins. Create the account normally via /users/create with this email.
AWS_REGION=
AWS_S3_BUCKET=
# SMTP config for EmailManager (src/util/email/EmailManager.ts). For Gmail: host=smtp.gmail.com, port=587, secure=false, and SMTP_PASS is a 16-char Google "App Password" (not your normal password).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
